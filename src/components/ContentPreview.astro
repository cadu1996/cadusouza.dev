---
interface Item {
  title: string;
  summary: string;
  href: string;
  meta: string;
  tags: string[];
}

interface Props {
  eyebrow: string;
  title: string;
  emptyTitle: string;
  emptyText: string;
  archiveHref: string;
  items: Item[];
}

const { eyebrow, title, emptyTitle, emptyText, archiveHref, items } = Astro.props;
---

<section class="section shell content-preview" aria-labelledby={`${eyebrow.toLowerCase()}-title`}>
  <div class="section-heading section-heading-row">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${eyebrow.toLowerCase()}-title`}>{title}</h2>
    </div>
    {items.length > 0 && <a class="text-link" href={archiveHref}>View all <span aria-hidden="true">↗</span></a>}
  </div>

  {items.length === 0 ? (
    <div class="empty-state">
      <span class="empty-index" aria-hidden="true">[ 00 ]</span>
      <div>
        <h3>{emptyTitle}</h3>
        <p>{emptyText}</p>
      </div>
    </div>
  ) : (
    <ul class="content-list">
      {items.map((item) => (
        <li>
          <a href={item.href}>
            <p class="content-meta">{item.meta}</p>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <ul class="tag-list" aria-label="Topics">
              {item.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </a>
        </li>
      ))}
    </ul>
  )}
</section>