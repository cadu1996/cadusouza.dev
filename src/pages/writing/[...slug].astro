---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getPublishedPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const publishedAt = post.data.publishedAt.toLocaleDateString('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<ContentLayout title={post.data.title} description={post.data.description} eyebrow="Writing">
  <div slot="meta" class="article-meta">
    <time datetime={post.data.publishedAt.toISOString()}>{publishedAt}</time>
    {post.data.tags.length > 0 && <span>{post.data.tags.join(' · ')}</span>}
  </div>
  <Content />
</ContentLayout>